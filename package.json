{
  "name": "coding-game",
  "description": "Code Quest — a Duolingo-style coding game for kids and teens, built with React + Vite.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BDCALL/Coding-game.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:live": "playwright test -c playwright.live.config.js",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify-drills.mjs && node scripts/verify-sidequest-drills.mjs && node scripts/verify-solutions.mjs",
    "verify:db": "node scripts/verify-display-names.mjs && node scripts/verify-schema.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  }
}
