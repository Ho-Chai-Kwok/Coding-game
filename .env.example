# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). The anon key is safe
# to expose client-side — real security comes from the Row Level Security
# policies in supabase/schema.sql, not from hiding this key.
#
# Without these set, Code Quest runs fine in guest-only mode (no login,
# progress stored on-device only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional launch settings ---
# Live address of the site (no trailing slash). Makes link previews work.
VITE_SITE_URL=
# Shown on the Privacy Policy / Terms pages as the contact address.
VITE_CONTACT_EMAIL=
# Cloudflare Turnstile site key. When set, sign-up/log-in/reset show a bot
# check; also enable CAPTCHA (Turnstile + secret key) in Supabase → Auth.
VITE_TURNSTILE_SITE_KEY=
