# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). The anon key is safe
# to expose client-side — real security comes from the Row Level Security
# policies in supabase/schema.sql, not from hiding this key.
#
# Without these set, Code Quest runs fine in guest-only mode (no login,
# progress stored on-device only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
